# Public client variables. Vite exposes only VITE_* values to the web and Android bundle.
# Web defaults to /api when these are empty.
VITE_API_BASE_URL=
VITE_API_ROOT=

# Android release builds should use the production HTTPS API.
VITE_ANDROID_API_BASE_URL=https://soflipco.com/api
VITE_ANDROID_API_ROOT=
VITE_PUBLIC_APP_ORIGIN=https://soflipco.com

# Only set this to true for local debug builds that intentionally use localhost,
# 127.0.0.1, or Android emulator host 10.0.2.2.
VITE_ALLOW_LOCAL_API=false

# Optional public Stripe key. Do not put Stripe secret keys in VITE_* variables.
VITE_STRIPE_PUBLISHABLE_KEY=

# Server-only variables. Never prefix these with VITE_.
PORT=3000
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
ADMIN_COOKIE_SAMESITE=none
CLIENT_ALLOWED_ORIGINS=https://soflipco.com,https://www.soflipco.com,https://localhost,capacitor://localhost
MOBILE_ALLOWED_ORIGINS=

# Crypto payment defaults for manual BTC/XMR TXID review.
CRYPTO_MODE=static_txid
CRYPTO_DESTINATION_PROVIDER=static_txid
CRYPTO_MONITORING_PROVIDER=none
CRYPTO_PAYMENT_EXPIRATION_MINUTES=30
CRYPTO_BTC_STATIC_ADDRESS=
CRYPTO_XMR_STATIC_ADDRESS=
CRYPTO_BTC_RECEIVING_ADDRESS=
CRYPTO_XMR_RECEIVING_ADDRESS=

# Optional automatic crypto monitoring.
CRYPTO_MONITOR_SCHEDULER_ENABLED=false
CRYPTO_MONITOR_INTERVAL_MINUTES=5
CRYPTO_MONITOR_STALE_ALERT_MINUTES=10
CRYPTO_BTC_MIN_CONFIRMATIONS=1
CRYPTO_XMR_MIN_CONFIRMATIONS=10
CRYPTO_BTC_WALLET_ALLOCATE_URL=
CRYPTO_BTC_MONITOR_LOOKUP_URL=
CRYPTO_BTC_WALLET_SERVICE_TOKEN=
CRYPTO_BTC_WALLET_ACCOUNT=saw-rent
CRYPTO_XMR_WALLET_RPC_URL=
CRYPTO_XMR_WALLET_RPC_USER=
CRYPTO_XMR_WALLET_RPC_PASSWORD=
CRYPTO_XMR_ACCOUNT_INDEX=0
