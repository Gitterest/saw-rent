          "pinnedDefault": true,
          "premium": false,
          "actionType": "osapp",
          "actionValue": "shop"
        },
        {
          "id": "support-center",
          "name": "Support Center",
          "icon": "🛟",
          "description": "Get help with orders, downloads, and custom requests.",
          "category": "Support",
          "featured": true,
          "pinnable": true,
          "pinnedDefault": true,
          "premium": false,
          "actionType": "osapp",
          "actionValue": "support-center"
        },
        {
          "id": "app-store",
          "name": "App Store",
          "icon": "🛍️",
          "description": "Discover new apps for your creative workflow.",
          "category": "System",
          "featured": true,
          "pinnable": true,
          "pinnedDefault": true,
          "premium": false,
          "actionType": "osapp",
          "actionValue": "app-store"
        },
        {
          "id": "settings",
          "name": "Settings",
          "icon": "⚙️",
          "description": "Personalize your Phia's Fab OS experience.",
          "category": "System",
          "featured": true,
          "pinnable": true,
          "pinnedDefault": true,
          "premium": false,
          "actionType": "osapp",
          "actionValue": "settings"
        },
        {
          "id": "vault",
          "name": "Digital Vault",
          "icon": "🗄️",
          "description": "Your downloads, licenses, and purchase history.",
          "category": "Library",
          "featured": true,
