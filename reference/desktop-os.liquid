          "actionType": "placeholder",
          "actionValue": "Decal Builder"
        }
      ]
    }
  </script>

  {%- assign digital_blocks = section.blocks | where: "type", "digital_category" -%}
  {%- assign goods_blocks = section.blocks | where: "type", "goods_category" -%}
  <script type="application/json" data-shop-config>
    {
      "digital": [
        {%- for block in digital_blocks -%}
          {
            "id": {{ block.id | json }},
            "label": {{ block.settings.label | json }},
            "handle": {{ block.settings.collection | json }}
          }{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      ],
      "goods": [
        {%- for block in goods_blocks -%}
          {
            "id": {{ block.id | json }},
            "label": {{ block.settings.label | json }},
            "handle": {{ block.settings.collection | json }}
          }{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      ]
    }
  </script>

  <div class="pf-windowlayer" data-windowlayer aria-label="Windows layer"></div>
</div>

{% schema %}
{
  "name": "Desktop OS",
  "settings": [],
  "blocks": [
    {
      "type": "digital_category",
      "name": "Digital category",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Folder label",
          "default": "Digital folder"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        }
      ]
    },
    {
      "type": "goods_category",
      "name": "Fab Goods category",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Folder label",
          "default": "Fab folder"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Desktop OS"
    }
  ]
}
{% endschema %}
