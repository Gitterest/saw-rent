          "premium": false,
          "actionType": "osapp",
          "actionValue": "tools"
        },
        {
          "id": "studio",
          "name": "Studio",
          "icon": "🧪",
          "description": "Creative studio for SVG workflows.",
          "category": "Creative",
          "featured": false,
          "pinnable": true,
          "pinnedDefault": false,
          "premium": false,
          "actionType": "osapp",
